// BrickPrice — modelo de datos (Fase 1)
// Provider SQLite para desarrollo local sin configuración.
// Para producción (Vercel + Neon) cambiar provider a "postgresql"
// y DATABASE_URL a la cadena de Postgres. El resto del esquema no cambia.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Temática (Star Wars, Technic, City...). Admite jerarquía padre/hijo.
model Theme {
  id       Int     @id @default(autoincrement())
  name     String
  slug     String  @unique
  color    String  @default("#1273d4") // color para el menú y las tarjetas
  parentId Int?
  parent   Theme?  @relation("ThemeChildren", fields: [parentId], references: [id])
  children Theme[] @relation("ThemeChildren")
  sets     Set[]

  @@index([parentId])
}

/// Set de LEGO. Origen de datos: Brickset.
model Set {
  id           Int            @id @default(autoincrement())
  setNumber    String         @unique // p.ej. "75192"
  name         String
  slug         String         @unique // p.ej. "75192-millennium-falcon"
  year         Int?
  pieces       Int?
  image        String?
  rrp          Float? // precio recomendado (PVP oficial)
  featured     Boolean        @default(false)
  themeId      Int
  theme        Theme          @relation(fields: [themeId], references: [id])
  offers       Offer[]
  priceHistory PriceHistory[]

  @@index([themeId])
}

/// Tienda (Amazon, El Corte Inglés, Fnac...).
model Store {
  id               Int            @id @default(autoincrement())
  name             String
  slug             String         @unique
  affiliateNetwork String? // "amazon" | "awin" | "tradedoubler"...
  offers           Offer[]
  priceHistory     PriceHistory[]
}

/// Oferta vigente de un set en una tienda concreta.
model Offer {
  id           Int      @id @default(autoincrement())
  setId        Int
  storeId      Int
  price        Float
  shipping     Float    @default(0)
  stock        String   @default("in") // "in" | "low" | "out"
  affiliateUrl String?
  updatedAt    DateTime @updatedAt
  set          Set      @relation(fields: [setId], references: [id])
  store        Store    @relation(fields: [storeId], references: [id])

  @@unique([setId, storeId])
  @@index([setId])
}

/// Histórico de precios: una fila por set/tienda/día para la gráfica y el mínimo histórico.
model PriceHistory {
  id      Int      @id @default(autoincrement())
  setId   Int
  storeId Int
  price   Float
  date    DateTime @default(now())
  set     Set      @relation(fields: [setId], references: [id])
  store   Store    @relation(fields: [storeId], references: [id])

  @@index([setId, date])
}
